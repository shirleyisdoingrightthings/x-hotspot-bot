<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    配置模板：复制为 ~/Library/LaunchAgents/com.shirley.x-hotspot-bot.plist 并填入真实值。

    ⚠️ 本 plist 不承担抓取调度，只是环境变量的唯一权威配置源。
    真正的写稿调度由 Antigravity Sidecar（x-hotspot-morning，每天 08:30）触发，
    09:30 由 com.shirley.x-hotspot-bot-health 执行轻量化健康检查。
-->
<dict>
    <key>Label</key>
    <string>com.shirley.x-hotspot-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/true</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 飞书自定义机器人 webhook：与 AI 产业日报共用同一个群机器人或独立配置 -->
        <key>FEISHU_WEBHOOK</key>
        <string>YOUR_FEISHU_WEBHOOK_URL</string>

        <!-- 本地代理（统一 1082）：抓取 latent.space / techmeme 需要，推送飞书是直连 -->
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:1082</string>
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:1082</string>

        <!-- 可选：启用哪些 provider，逗号分隔。缺省 ainews,techmeme。 -->
        <key>X_BOT_PROVIDERS</key>
        <string>ainews,techmeme</string>

        <!-- 时效窗口（小时），缺省 48（次早 08:30 独立运行窗口） -->
        <key>X_BOT_WINDOW_H</key>
        <string>48</string>
    </dict>
</dict>
</plist>
