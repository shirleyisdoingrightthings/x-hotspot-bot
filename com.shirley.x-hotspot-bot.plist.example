<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    配置模板：复制为 ~/Library/LaunchAgents/com.shirley.x-hotspot-bot.plist 并填入真实值。

    ⚠️ 本 plist 不承担任何调度职责，和另外三个 bot 一致：它只是环境变量的唯一
    权威配置源（health_check.sh 用 PlistBuddy 从 EnvironmentVariables 读 FEISHU_*）。
    ProgramArguments 固定为 /usr/bin/true，仅为满足 launchd 对 plist 结构的要求，
    永远不会被触发。真正的调度在 Claude App 的定时任务里。
-->
<dict>
    <key>Label</key>
    <string>com.shirley.x-hotspot-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/true</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 飞书自定义机器人 webhook：群「设置 → 群机器人 → 添加机器人
             → 自定义机器人」里取得，形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
             想单独开一个「X 热点」群就新建一个机器人，别和 AI 日报共用。 -->
        <key>FEISHU_WEBHOOK</key>
        <string>YOUR_FEISHU_WEBHOOK_URL</string>

        <!-- 本地代理：抓 news.smol.ai / techmeme 需要，推送飞书是直连 -->
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:YOUR_PORT</string>
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:YOUR_PORT</string>

        <!-- 可选：启用哪些 provider，逗号分隔。缺省 ainews,techmeme。 -->
        <key>X_BOT_PROVIDERS</key>
        <string>ainews,techmeme</string>

        <!-- 可选：时效窗口（小时），缺省 48。别调到 24——
             X 上的讨论常要发酵一两天才到顶，24h 会漏掉半数话题。 -->
        <key>X_BOT_WINDOW_H</key>
        <string>48</string>
    </dict>
</dict>
</plist>
